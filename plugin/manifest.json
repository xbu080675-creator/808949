{
  "specVersion": 2,
  "id": "com.tavo.multimodal.probe",
  "name": "Tavo Multimodal",
  "version": "0.0.8",
  "author": "Tavo Multimodal",
  "description": "多模态技术验证：手动检查宿主接口、配置、变量存储及媒体文件读取，不自动发送聊天内容。",
  "localization": {
    "defaultLocale": "zh-CN"
  },
  "entry": "entry.js",
  "permissions": [
    "message",
    "variable",
    "file",
    "network",
    "generate",
    "tts"
  ],
  "contributes": {
    "inputActions": [
      {
        "id": "probe",
        "label": "多模态诊断"
      },
      {
        "id": "media",
        "label": "测试音视频文件"
      },
      {
        "id": "network",
        "label": "测试 API 网络"
      },
      {
        "id": "native",
        "label": "测试原生网络下载"
      },
      {
        "id": "report",
        "label": "导出网络诊断报告"
      },
      {
        "id": "generate",
        "label": "测试 Tavo 原生模型（可能计费）"
      },
      {
        "id": "post",
        "label": "测试独立 POST（无认证）"
      },
      {
        "id": "decide",
        "label": "分析多模态意图（可能计费）"
      },
      {
        "id": "decisionReport",
        "label": "导出媒体决策"
      },
      {
        "id": "manual_image",
        "label": "手动生成图片"
      },
      {
        "id": "manual_voice",
        "label": "手动角色语音"
      },
      {
        "id": "execute",
        "label": "执行媒体决策"
      },
      {
        "id": "lastImage",
        "label": "查看最近生成图片"
      },
      {
        "id": "askProbe",
        "label": "测试输入弹窗"
      },
      {
        "id": "imageProbe",
        "label": "固定图片测试（点击即生成，可能计费）"
      },
      {
        "id": "voiceProbe",
        "label": "固定语音测试（点击即播放，可能计费）"
      },
      {
        "id": "mediaReport",
        "label": "导出媒体诊断"
      },
      {
        "id": "readLatest",
        "label": "朗读最近角色消息（可能计费）"
      },
      {
        "id": "imageDecisionDirect",
        "label": "直接执行图片决策（可能计费）"
      },
      {
        "id": "forcePlan",
        "label": "强制图片规划（可能计费）"
      }
    ],
    "settings": {
      "schema": [
        {
          "type": "info",
          "text": "手动意图分析会将最近最多六条可见消息的部分文本发送到当前模型，可能计费；仅预览，不生成媒体。其他测试不发送聊天内容。",
          "icon": "info"
        },
        {
          "key": "endpoint",
          "type": "text",
          "label": "HTTPS API 测试地址",
          "default": ""
        },
        {
          "key": "model",
          "type": "text",
          "label": "模型名称",
          "default": ""
        },
        {
          "key": "protocol",
          "type": "select",
          "label": "独立 POST 协议",
          "default": "openai",
          "options": [
            {
              "value": "openai",
              "label": "OpenAI"
            },
            {
              "value": "anthropic",
              "label": "Anthropic"
            }
          ]
        },
        {
          "key": "autoVoice",
          "type": "switch",
          "label": "自动角色语音（可能计费）",
          "default": false
        },
        {
          "key": "smartVoice",
          "type": "switch",
          "label": "仅在智能决策推荐语音时朗读",
          "default": false
        },
        {
          "key": "autoAnalyze",
          "type": "switch",
          "label": "自动智能分析（发送近期聊天，可能计费）",
          "default": false
        },
        {
          "key": "autoImage",
          "type": "switch",
          "label": "自动分析并生图（可能计费）",
          "default": false
        }
      ]
    }
  }
}