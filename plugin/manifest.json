{
  "specVersion": 2,
  "id": "com.tavo.multimodal.probe",
  "name": "Tavo Multimodal",
  "version": "0.0.16",
  "author": "Tavo Multimodal",
  "description": "原生媒体能力优先：智能调度、角色视觉档案、频率及费用保护。",
  "localization": {
    "defaultLocale": "zh-CN"
  },
  "entry": "entry.js",
  "permissions": [
    "message",
    "variable",
    "file",
    "network",
    "generate",
    "tts"
  ],
  "contributes": {
    "inputActions": [
      {
        "id": "decide",
        "label": "智能媒体分析（可能计费）"
      },
      {
        "id": "forcePlan",
        "label": "规划剧情图片（可能计费）"
      },
      {
        "id": "execute",
        "label": "执行媒体决策"
      },
      {
        "id": "readLatest",
        "label": "朗读最近角色回复（可能计费）"
      },
      {
        "id": "mediaMenu",
        "label": "媒体操作"
      },
      {
        "id": "profileMenu",
        "label": "角色视觉档案"
      },
      {
        "id": "manageMenu",
        "label": "记录与缓存管理"
      },
      {
        "id": "diagnosticMenu",
        "label": "高级诊断与原生说明"
      }
    ],
    "settings": {
      "schema": [
        {
          "type": "info",
          "text": "图片识别使用Tavo原生图片发送。调试模式仅拦截插件生图和TTS，文本分析可能计费。插件自动语音开启时建议关闭Tavo自带自动播放。 音视频元数据接入默认关闭；开启后匹配附件由插件转为元数据文本，可能随聊天发送至模型。 大视频默认完整读取50MB，可选100MB（实验）；超出读取上限至200MB只返回基本文件信息。音频50MB，图片20MB。",
          "icon": "info"
        },
        {
          "key": "endpoint",
          "type": "text",
          "label": "HTTPS API 测试地址",
          "default": ""
        },
        {
          "key": "model",
          "type": "text",
          "label": "模型名称",
          "default": ""
        },
        {
          "key": "protocol",
          "type": "select",
          "label": "独立 POST 协议",
          "default": "openai",
          "options": [
            {
              "value": "openai",
              "label": "OpenAI"
            },
            {
              "value": "anthropic",
              "label": "Anthropic"
            }
          ]
        },
        {
          "key": "autoVoice",
          "type": "switch",
          "label": "自动角色语音（可能计费）",
          "default": false
        },
        {
          "key": "smartVoice",
          "type": "switch",
          "label": "仅在智能决策推荐语音时朗读",
          "default": false
        },
        {
          "key": "autoAnalyze",
          "type": "switch",
          "label": "自动智能分析（发送近期聊天，可能计费）",
          "default": false
        },
        {
          "key": "autoImage",
          "type": "switch",
          "label": "自动分析并生图（可能计费）",
          "default": false
        },
        {
          "key": "debugMode",
          "type": "switch",
          "label": "零媒体费用调试模式",
          "default": true
        },
        {
          "key": "planInterval",
          "type": "select",
          "label": "自动分析间隔",
          "default": "3",
          "options": [
            {
              "value": "1",
              "label": "每 1 条角色回复"
            },
            {
              "value": "2",
              "label": "每 2 条角色回复"
            },
            {
              "value": "3",
              "label": "每 3 条角色回复"
            },
            {
              "value": "5",
              "label": "每 5 条角色回复"
            },
            {
              "value": "10",
              "label": "每 10 条角色回复"
            }
          ]
        },
        {
          "key": "voiceInterval",
          "type": "select",
          "label": "自动语音间隔",
          "default": "2",
          "options": [
            {
              "value": "1",
              "label": "每 1 条角色回复"
            },
            {
              "value": "2",
              "label": "每 2 条角色回复"
            },
            {
              "value": "3",
              "label": "每 3 条角色回复"
            },
            {
              "value": "5",
              "label": "每 5 条角色回复"
            },
            {
              "value": "10",
              "label": "每 10 条角色回复"
            }
          ]
        },
        {
          "key": "imageInterval",
          "type": "select",
          "label": "自动生图间隔",
          "default": "5",
          "options": [
            {
              "value": "1",
              "label": "每 1 条角色回复"
            },
            {
              "value": "2",
              "label": "每 2 条角色回复"
            },
            {
              "value": "3",
              "label": "每 3 条角色回复"
            },
            {
              "value": "5",
              "label": "每 5 条角色回复"
            },
            {
              "value": "10",
              "label": "每 10 条角色回复"
            }
          ]
        },
        {
          "key": "autoInsertImage",
          "type": "switch",
          "label": "生图成功后自动插入聊天",
          "default": false
        },
        {
          "key": "nativeVoiceRules",
          "type": "switch",
          "label": "自动语音遵循原生朗读规则",
          "default": true
        },
        {
          "key": "localMediaInput",
          "type": "switch",
          "label": "本地音视频元数据接入（实验，非内容理解）",
          "default": false
        },
        {
          "key": "videoReadLimit",
          "type": "select",
          "label": "视频完整读取上限（大文件可能占用内存）",
          "default": "50",
          "options": [
            {
              "value": "50",
              "label": "50MB（推荐）"
            },
            {
              "value": "100",
              "label": "100MB（实验）"
            }
          ]
        }
      ]
    },
    "fileProcessors": [
      {
        "id": "local-media-meta",
        "extensions": [
          "mp4",
          "mov",
          "m4a",
          "wav"
        ],
        "entry": "processor.js"
      }
    ]
  }
}