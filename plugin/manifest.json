{
  "specVersion": 2,
  "id": "com.tavo.multimodal.probe",
  "name": "Tavo Multimodal",
  "version": "0.0.9",
  "author": "Tavo Multimodal",
  "description": "多模态决策、语音和生图联动；默认媒体调试模式，不调用生图或 TTS。",
  "localization": {
    "defaultLocale": "zh-CN"
  },
  "entry": "entry.js",
  "permissions": [
    "message",
    "variable",
    "file",
    "network",
    "generate",
    "tts"
  ],
  "contributes": {
    "inputActions": [
      {
        "id": "probe",
        "label": "多模态诊断"
      },
      {
        "id": "media",
        "label": "测试音视频文件"
      },
      {
        "id": "network",
        "label": "测试 API 网络"
      },
      {
        "id": "native",
        "label": "测试原生网络下载"
      },
      {
        "id": "report",
        "label": "导出网络诊断报告"
      },
      {
        "id": "generate",
        "label": "测试 Tavo 原生模型（可能计费）"
      },
      {
        "id": "post",
        "label": "测试独立 POST（无认证）"
      },
      {
        "id": "decide",
        "label": "分析多模态意图（可能计费）"
      },
      {
        "id": "decisionReport",
        "label": "导出媒体决策"
      },
      {
        "id": "manual_image",
        "label": "手动生成图片"
      },
      {
        "id": "manual_voice",
        "label": "手动角色语音"
      },
      {
        "id": "execute",
        "label": "执行媒体决策"
      },
      {
        "id": "lastImage",
        "label": "查看最近生成图片"
      },
      {
        "id": "askProbe",
        "label": "测试输入弹窗"
      },
      {
        "id": "imageProbe",
        "label": "固定图片测试（点击即生成，可能计费）"
      },
      {
        "id": "voiceProbe",
        "label": "固定语音测试（点击即播放，可能计费）"
      },
      {
        "id": "mediaReport",
        "label": "导出媒体诊断"
      },
      {
        "id": "readLatest",
        "label": "朗读最近角色消息（可能计费）"
      },
      {
        "id": "imageDecisionDirect",
        "label": "直接执行图片决策（可能计费）"
      },
      {
        "id": "forcePlan",
        "label": "强制图片规划（可能计费）"
      },
      {
        "id": "autoReport",
        "label": "导出自动事件记录"
      },
      {
        "id": "resumeAuto",
        "label": "解除自动任务暂停"
      },
      {
        "id": "readProbe",
        "label": "测试消息读取（不调用 API）"
      }
    ],
    "settings": {
      "schema": [
        {
          "type": "info",
          "text": "默认媒体调试模式拦截插件发起的生图和 TTS。智能分析和图片规划仍调用当前文本模型，可能计费；自动分析仅在相关开关开启时执行。",
          "icon": "info"
        },
        {
          "key": "endpoint",
          "type": "text",
          "label": "HTTPS API 测试地址",
          "default": ""
        },
        {
          "key": "model",
          "type": "text",
          "label": "模型名称",
          "default": ""
        },
        {
          "key": "protocol",
          "type": "select",
          "label": "独立 POST 协议",
          "default": "openai",
          "options": [
            {
              "value": "openai",
              "label": "OpenAI"
            },
            {
              "value": "anthropic",
              "label": "Anthropic"
            }
          ]
        },
        {
          "key": "autoVoice",
          "type": "switch",
          "label": "自动角色语音（可能计费）",
          "default": false
        },
        {
          "key": "smartVoice",
          "type": "switch",
          "label": "仅在智能决策推荐语音时朗读",
          "default": false
        },
        {
          "key": "autoAnalyze",
          "type": "switch",
          "label": "自动智能分析（发送近期聊天，可能计费）",
          "default": false
        },
        {
          "key": "autoImage",
          "type": "switch",
          "label": "自动分析并生图（可能计费）",
          "default": false
        },
        {
          "key": "debugMode",
          "type": "switch",
          "label": "零媒体费用调试模式",
          "default": true
        }
      ]
    }
  }
}