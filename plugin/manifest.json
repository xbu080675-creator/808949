{
  "specVersion": 2,
  "id": "com.tavo.multimodal.probe",
  "name": "Tavo Multimodal",
  "version": "0.0.13",
  "author": "Tavo Multimodal",
  "description": "多模态决策、语音和生图联动；默认媒体调试模式，不调用生图或 TTS。",
  "localization": {
    "defaultLocale": "zh-CN"
  },
  "entry": "entry.js",
  "permissions": [
    "message",
    "variable",
    "file",
    "network",
    "generate",
    "tts"
  ],
  "contributes": {
    "inputActions": [
      {
        "id": "probe",
        "label": "多模态诊断"
      },
      {
        "id": "media",
        "label": "测试音视频文件"
      },
      {
        "id": "network",
        "label": "测试 API 网络"
      },
      {
        "id": "native",
        "label": "测试原生网络下载"
      },
      {
        "id": "report",
        "label": "导出网络诊断报告"
      },
      {
        "id": "generate",
        "label": "测试 Tavo 原生模型（可能计费）"
      },
      {
        "id": "post",
        "label": "测试独立 POST（无认证）"
      },
      {
        "id": "decide",
        "label": "分析多模态意图（可能计费）"
      },
      {
        "id": "decisionReport",
        "label": "导出媒体决策"
      },
      {
        "id": "manual_image",
        "label": "手动生成图片"
      },
      {
        "id": "manual_voice",
        "label": "手动角色语音"
      },
      {
        "id": "execute",
        "label": "执行媒体决策"
      },
      {
        "id": "lastImage",
        "label": "查看最近生成图片"
      },
      {
        "id": "askProbe",
        "label": "测试输入弹窗"
      },
      {
        "id": "imageProbe",
        "label": "固定图片测试（点击即生成，可能计费）"
      },
      {
        "id": "voiceProbe",
        "label": "固定语音测试（点击即播放，可能计费）"
      },
      {
        "id": "mediaReport",
        "label": "导出媒体诊断"
      },
      {
        "id": "readLatest",
        "label": "朗读最近角色消息（可能计费）"
      },
      {
        "id": "imageDecisionDirect",
        "label": "直接执行图片决策（可能计费）"
      },
      {
        "id": "forcePlan",
        "label": "强制图片规划（可能计费）"
      },
      {
        "id": "autoReport",
        "label": "导出自动事件记录"
      },
      {
        "id": "resumeAuto",
        "label": "解除自动任务暂停"
      },
      {
        "id": "readProbe",
        "label": "测试消息读取（不调用 API）"
      },
      {
        "id": "hookProbe",
        "label": "检查事件注册（不调用 API）"
      },
      {
        "id": "visualEdit",
        "label": "编辑角色视觉档案"
      },
      {
        "id": "visualExport",
        "label": "导出角色视觉档案"
      },
      {
        "id": "visualClear",
        "label": "清空角色视觉档案"
      },
      {
        "id": "frequencyReport",
        "label": "导出频率与额度记录"
      },
      {
        "id": "importMediaProbe",
        "label": "本地多模态文件测试（不上传）"
      },
      {
        "id": "insertImage",
        "label": "插入最近图片到聊天"
      },
      {
        "id": "cacheReport",
        "label": "导出图片缓存记录"
      },
      {
        "id": "cacheClean",
        "label": "清理未插入图片缓存"
      },
      {
        "id": "visionProbe",
        "label": "图片内容识别（决策 API，可能计费）"
      },
      {
        "id": "visionReport",
        "label": "导出图片识别报告"
      }
    ],
    "settings": {
      "schema": [
        {
          "type": "info",
          "text": "默认媒体调试拦截插件生图和 TTS。文本规划仍可能计费，使用近期消息、角色描述和自建视觉档案。自动请求限额按聊天及UTC日期计算，手动请求不计入。",
          "icon": "info"
        },
        {
          "key": "endpoint",
          "type": "text",
          "label": "HTTPS API 测试地址",
          "default": ""
        },
        {
          "key": "model",
          "type": "text",
          "label": "模型名称",
          "default": ""
        },
        {
          "key": "protocol",
          "type": "select",
          "label": "独立 POST 协议",
          "default": "openai",
          "options": [
            {
              "value": "openai",
              "label": "OpenAI"
            },
            {
              "value": "anthropic",
              "label": "Anthropic"
            }
          ]
        },
        {
          "key": "autoVoice",
          "type": "switch",
          "label": "自动角色语音（可能计费）",
          "default": false
        },
        {
          "key": "smartVoice",
          "type": "switch",
          "label": "仅在智能决策推荐语音时朗读",
          "default": false
        },
        {
          "key": "autoAnalyze",
          "type": "switch",
          "label": "自动智能分析（发送近期聊天，可能计费）",
          "default": false
        },
        {
          "key": "autoImage",
          "type": "switch",
          "label": "自动分析并生图（可能计费）",
          "default": false
        },
        {
          "key": "debugMode",
          "type": "switch",
          "label": "零媒体费用调试模式",
          "default": true
        },
        {
          "key": "planInterval",
          "type": "select",
          "label": "自动分析间隔",
          "default": "3",
          "options": [
            {
              "value": "1",
              "label": "每 1 条角色回复"
            },
            {
              "value": "2",
              "label": "每 2 条角色回复"
            },
            {
              "value": "3",
              "label": "每 3 条角色回复"
            },
            {
              "value": "5",
              "label": "每 5 条角色回复"
            },
            {
              "value": "10",
              "label": "每 10 条角色回复"
            }
          ]
        },
        {
          "key": "voiceInterval",
          "type": "select",
          "label": "自动语音间隔",
          "default": "2",
          "options": [
            {
              "value": "1",
              "label": "每 1 条角色回复"
            },
            {
              "value": "2",
              "label": "每 2 条角色回复"
            },
            {
              "value": "3",
              "label": "每 3 条角色回复"
            },
            {
              "value": "5",
              "label": "每 5 条角色回复"
            },
            {
              "value": "10",
              "label": "每 10 条角色回复"
            }
          ]
        },
        {
          "key": "imageInterval",
          "type": "select",
          "label": "自动生图间隔",
          "default": "5",
          "options": [
            {
              "value": "1",
              "label": "每 1 条角色回复"
            },
            {
              "value": "2",
              "label": "每 2 条角色回复"
            },
            {
              "value": "3",
              "label": "每 3 条角色回复"
            },
            {
              "value": "5",
              "label": "每 5 条角色回复"
            },
            {
              "value": "10",
              "label": "每 10 条角色回复"
            }
          ]
        },
        {
          "key": "autoInsertImage",
          "type": "switch",
          "label": "生图成功后自动插入聊天",
          "default": false
        }
      ]
    }
  }
}